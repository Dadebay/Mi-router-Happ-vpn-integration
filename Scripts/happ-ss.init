#!/bin/sh /etc/rc.common
START=92
STOP=10
USE_PROCD=1

start_service() {
    [ -r /etc/happvpn/ss-client.json ] || return 1

    procd_open_instance local
    procd_set_param command /usr/bin/ss-local -c /etc/happvpn/ss-client.json -b 127.0.0.1 -l 1080
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance redirect
    procd_set_param command /usr/bin/ss-redir -c /etc/happvpn/ss-client.json -b 0.0.0.0 -l 12345
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance dns
    procd_set_param command /usr/bin/lua5.3 /etc/happvpn/dns-relay.lua
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
}
